<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/traffic_history_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:minHeight="48dp"
        android:title="Статистика"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/period_selector_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="5dp">

                    <TextView
                        android:id="@+id/tab_today"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Сегодня"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tab_week"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="7 дней"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tab_month"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Месяц"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/tab_all_time"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1.18"
                        android:gravity="center"
                        android:maxLines="1"
                        android:text="Всё время"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/history_hero_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/selected_period_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Последние 7 дней"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/selected_total_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="0 Б"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/selected_rx_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_download"
                                android:drawablePadding="4dp"
                                android:text="Получено"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/selected_rx_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:text="0 Б"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:layout_marginHorizontal="8dp"
                            android:background="#447F8D86" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/selected_tx_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/ic_upload"
                                android:drawablePadding="4dp"
                                android:text="Отправлено"
                                android:textSize="10sp" />
                            <TextView
                                android:id="@+id/selected_tx_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:text="0 Б"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/history_chart_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="6dp">
                    <TextView
                        android:id="@+id/history_chart_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Трафик за последние 7 дней"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/history_chart_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Общий трафик за день · Гб"
                        android:textSize="10sp" />
                    <org.amnezia.awg.dashboard.TrafficBarChartView
                        android:id="@+id/traffic_chart"
                        android:layout_width="match_parent"
                        android:layout_height="205dp"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/history_summary_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                android:text="Сводка"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/history_rollup_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">
                    <LinearLayout
                        android:id="@+id/rollup_header_row"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/rollup_header_period"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.86"
                            android:maxLines="1"
                            android:text="Период"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/rollup_header_rx"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.08"
                            android:drawableStart="@drawable/ic_download_small"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:text="Скачано"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/rollup_header_tx"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.02"
                            android:drawableStart="@drawable/ic_upload_small"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:text="Отдано"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/rollup_header_total"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.04"
                            android:gravity="end|center_vertical"
                            android:maxLines="1"
                            android:text="Всего"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/today_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.86"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="Сегодня"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/today_rx_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.08"
                            android:drawableStart="@drawable/ic_download_small"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/today_tx_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.02"
                            android:drawableStart="@drawable/ic_upload_small"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/today_total_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.04"
                            android:gravity="end|center_vertical"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <View android:id="@+id/rollup_divider_1" android:layout_width="match_parent" android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/week_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.86"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="7 дней"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/week_rx_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.08"
                            android:drawableStart="@drawable/ic_download_small"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/week_tx_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.02"
                            android:drawableStart="@drawable/ic_upload_small"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/week_total_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.04"
                            android:gravity="end|center_vertical"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <View android:id="@+id/rollup_divider_2" android:layout_width="match_parent" android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/month_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.86"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="Этот месяц"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/month_rx_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.08"
                            android:drawableStart="@drawable/ic_download_small"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/month_tx_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.02"
                            android:drawableStart="@drawable/ic_upload_small"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/month_total_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.04"
                            android:gravity="end|center_vertical"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <View android:id="@+id/rollup_divider_3" android:layout_width="match_parent" android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="34dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/all_time_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.86"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="Всё время"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/all_time_rx_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.08"
                            android:drawableStart="@drawable/ic_download_small"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/all_time_tx_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.02"
                            android:drawableStart="@drawable/ic_upload_small"
                            android:drawablePadding="2dp"
                            android:gravity="center_vertical|start"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—"
                            android:textSize="10sp" />
                        <TextView
                            android:id="@+id/all_time_total_value"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.04"
                            android:gravity="end|center_vertical"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:text="—"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
